# Frames for demo/demo.gif — run demo/record.sh, which renders them with vhs and assembles the GIF.
Output demo/frames/
Set FontSize 15
Set Width 1200
Set Height 760
Set Framerate 25
Set Theme "Catppuccin Mocha"
Set TypingSpeed 40ms
Hide
Type "clear" Enter
Show
Type "bash demo/demo.sh" Enter
Sleep 20s
